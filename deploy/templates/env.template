# =====================================================================
# Generic env template used by install.sh (option 4) for nl1 / nl2.
# Stack-specific copies live in deploy/{single,nl1,nl2}/.env.example.
# For the single topology install.sh fills deploy/single/.env.example
# directly (it already carries XACCEL_ENABLED=true, STORAGE_MIN_FREE_MB
# and the per-worker DB pool). This file is the lowest common denominator.
# =====================================================================

APP_ROLE=all
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

BOT_TOKEN=replace-me
BOT_ADMIN_IDS=
TELEGRAM_MAX_UPLOAD_MB=49

POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dwtgbot
POSTGRES_USER=dwtgbot
POSTGRES_PASSWORD=__PG_PASS__
DATABASE_URL=postgresql+asyncpg://dwtgbot:__PG_PASS__@postgres:5432/dwtgbot
DB_STATEMENT_TIMEOUT_S=30
DB_CONNECT_TIMEOUT_S=10
DB_IDLE_IN_TX_TIMEOUT_MS=60000

REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

STORAGE_PATH=/var/lib/dwtgbot/storage
STORAGE_TMP_PATH=/var/lib/dwtgbot/tmp
MAX_FILE_SIZE_MB=2048

PUBLIC_BASE_URL=https://__DOMAIN__
SERVER_NAME=__DOMAIN__
TEMP_LINK_TTL_SECONDS=86400
TEMP_LINK_MAX_DOWNLOADS=5
TEMP_LINK_TOKEN_BYTES=32

API_HOST=0.0.0.0
API_PORT=8080
API_INTERNAL_TOKEN=__API_TOKEN__

WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_RETRIES=2
DOWNLOAD_TIMEOUT_SECONDS=900

CLEANUP_INTERVAL_SECONDS=3600
MEDIA_CACHE_TTL_SECONDS=21600
ORPHAN_JOB_AGE_SECONDS=3900

BACKUP_DIR=/var/backups/dwtgbot
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400

FFMPEG_BIN=ffmpeg
YTDLP_BIN=yt-dlp

IMAGE_BOT=ghcr.io/your-org/dwtgbot-bot:latest
IMAGE_API=ghcr.io/your-org/dwtgbot-api:latest
IMAGE_WORKER=ghcr.io/your-org/dwtgbot-worker:latest
IMAGE_BACKUP=ghcr.io/your-org/dwtgbot-backup:latest
