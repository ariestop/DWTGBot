# =====================================================================
# Пример конфигурации автодеплоя для systemd-сервиса.
# Файл предназначен для установки в /etc/dwtgbot/autodeploy.env
# и не должен коммититься с реальными секретами.
# =====================================================================

# Какой стек обслуживает этот сервер: nl1 или nl2.
DEPLOY_TARGET=__TARGET__

# Абсолютный путь к checkout репозитория на сервере.
REPO_PATH=__REPO_PATH__

# Координаты GitHub-репозитория.
GITHUB_OWNER=__GITHUB_OWNER__
GITHUB_REPO=__GITHUB_REPO__
GITHUB_BRANCH=main
GITHUB_API_URL=https://api.github.com

# Fine-grained PAT или другой токен GitHub с правами:
# - Actions: read
# - Contents: read
# - Deployments: read/write
GITHUB_TOKEN=

# Общий префикс для immutable образов в GHCR.
# Итоговые имена будут вида:
#   ${GHCR_REPO_PREFIX}-api:sha-<short>
#   ${GHCR_REPO_PREFIX}-worker:sha-<short>
GHCR_REPO_PREFIX=__GHCR_REPO_PREFIX__

# Какие workflow обязаны быть зелёными для целевого SHA.
CI_WORKFLOW_FILE=ci.yml
BUILD_WORKFLOW_FILE=build-images.yml

# GitHub environment names для статусов автодеплоя.
GITHUB_ENVIRONMENT_NL1=nl1-autodeploy
GITHUB_ENVIRONMENT_NL2=nl2-autodeploy

# Каталог локального состояния автодеплоя.
AUTODEPLOY_STATE_DIR=/var/lib/dwtgbot/autodeploy

# Для отладки можно включить dry-run:
# AUTODEPLOY_DRY_RUN=1
