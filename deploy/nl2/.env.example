# =====================================================================
# NL-2 (media plane) environment.
# Copy to deploy/nl2/.env on the server. NEVER commit the real .env.
#
# POSTGRES_HOST / REDIS_HOST should point to NL-1 over the private network
# (typically WireGuard, e.g. 10.10.0.1).
# =====================================================================

# ---------- Image tags (REQUIRED; immutable; set per release) ----------
# Audit fix #4: docker-compose ``${VAR:?}``-checks each IMAGE_* var.
# Never use ``:latest`` — pin to ``sha-XXXXXXX`` (CI) or ``vX.Y.Z``.
IMAGE_API=ghcr.io/your-org/dwtgbot-api:sha-REPLACE_ME
IMAGE_WORKER=ghcr.io/your-org/dwtgbot-worker:sha-REPLACE_ME

# ---------- App ----------
APP_ROLE=worker
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

# ---------- Telegram ----------
BOT_TOKEN=replace-me                # SAME token as on NL-1
BOT_ADMIN_IDS=
TELEGRAM_MAX_UPLOAD_MB=49

# ---------- Postgres (NL-1 over private network) ----------
POSTGRES_HOST=10.10.0.1
POSTGRES_PORT=5432
POSTGRES_DB=dwtgbot
POSTGRES_USER=dwtgbot
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://dwtgbot:replace-me@10.10.0.1:5432/dwtgbot
# S5: worker holds a session per active job + cleanup tasks. Allow at
# least WORKER_CONCURRENCY × 3 so cleanup + status updates don't queue.
DB_POOL_SIZE=20
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=1800

# ---------- Redis (NL-1 over private network) ----------
REDIS_HOST=10.10.0.1
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://10.10.0.1:6379/0

# ---------- Public delivery ----------
SERVER_NAME=media.example.com
PUBLIC_BASE_URL=https://media.example.com
TEMP_LINK_TTL_SECONDS=86400
TEMP_LINK_MAX_DOWNLOADS=5
TEMP_LINK_TOKEN_BYTES=32

# ---------- Storage ----------
STORAGE_PATH=/var/lib/dwtgbot/storage
STORAGE_TMP_PATH=/var/lib/dwtgbot/tmp
MAX_FILE_SIZE_MB=2048
# S10: NL-2 SHOULD set this to keep ~3 × MAX_FILE_SIZE_MB of headroom.
# Worker fails the job permanently when free space drops below this.
STORAGE_MIN_FREE_MB=6144

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8080
API_INTERNAL_TOKEN=replace-me
# Dev/CI-only — leave EMPTY in production. See docs/37-load-and-capacity.md §6.
INTERNAL_TEST_TOKEN=
# S6: NL-2 IS the box behind the bundled nginx, so we trust the
# X-Internal-XAccel header here. Bot/api containers on NL-1 must keep
# this disabled (api there is reached directly over WireGuard).
XACCEL_ENABLED=true

# ---------- Worker / queue ----------
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_RETRIES=2
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_CONCURRENT_JOBS_PER_USER=2

# ---------- Cleanup / cache ----------
CLEANUP_INTERVAL_SECONDS=3600
MEDIA_CACHE_TTL_SECONDS=21600
# S1: leave ≥ JOB_TIMEOUT_SECONDS × 2 — NL-2 runs the cleanup worker.
ORPHAN_JOB_AGE_SECONDS=3900

# ---------- Tooling ----------
FFMPEG_BIN=ffmpeg
YTDLP_BIN=yt-dlp
# S9: outbound proxy for yt-dlp upstream calls. Empty = direct. Format:
# http://user:pass@host:port  or  socks5h://host:port
HTTPS_PROXY_URL=

# ---------- Circuit breaker (L5) ----------
# Shared via Redis across all worker replicas on NL-2.
CB_ENABLED=true
CB_FAILURE_THRESHOLD=5
CB_WINDOW_SECONDS=60
CB_COOLDOWN_SECONDS=300

# ---------- Sentry (L7) — optional error aggregation ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# ---------- Rate limiting (docs/36-rate-limiting.md) ----------
# Bot lives on NL-1, but worker reads the same Settings model — keeping
# these in sync prevents validate_runtime divergence. The worker itself
# never calls the limiter (P11: limiter lives only at the bot edge).
RL_ENABLED=false
RL_USER_BURST=5/60
RL_USER_HOURLY=20/3600
RL_CHAT_BURST=15/60
RL_GLOBAL_BURST=60/60
RL_DOMAIN_BURST=30/60
RL_NOTICE_TTL=30
RL_CHAT_NOTICE_TTL=30
RL_FAIL_OPEN=true

# ---------- Metrics (worker side — kept in sync with NL-1) ----------
# The worker doesn't run /metrics today (limiter lives at the bot edge,
# P11). These keys exist only so Settings.validate_runtime stays
# identical across nodes — flipping METRICS_ENABLED=true here is a no-op.
METRICS_ENABLED=false
METRICS_BIND_HOST=127.0.0.1
METRICS_PORT=9090
METRICS_USER_ID_LABEL=false

# ---------- Backup (unused on NL-2) ----------
BACKUP_DIR=/var/backups/dwtgbot
BACKUP_RETENTION_DAYS=14
