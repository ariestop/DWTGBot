# =====================================================================
# NL-1 (control plane) environment.
# Copy to deploy/nl1/.env on the server. NEVER commit the real .env.
# =====================================================================

# ---------- Image tags (REQUIRED; immutable; set per release) ----------
# Audit fix #4: docker-compose now ``${VAR:?}``-checks each IMAGE_*
# variable, so ``docker compose up`` fails fast if you forgot one.
# NEVER use ``:latest`` or any other mutable tag in production —
# rollbacks become ambiguous and fresh hosts can boot a different
# build than the one you intended. Use ``sha-XXXXXXX`` (CI build)
# or ``vX.Y.Z`` (release).
#
# CI pushes to ``ghcr.io/<owner>/<repo>-<svc>:sha-<short>`` (repo name is
# lowercased — ``DWTGBot`` → ``dwtgbot`` — Docker requires lowercase).
# Forks: replace ``ariestop/dwtgbot`` with ``your-user/your-fork``.
IMAGE_BOT=ghcr.io/ariestop/dwtgbot-bot:sha-REPLACE_ME
IMAGE_API=ghcr.io/ariestop/dwtgbot-api:sha-REPLACE_ME
IMAGE_BACKUP=ghcr.io/ariestop/dwtgbot-backup:sha-REPLACE_ME

# ---------- App ----------
APP_ROLE=bot
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

# ---------- Telegram ----------
BOT_TOKEN=replace-me
BOT_ADMIN_IDS=
TELEGRAM_MAX_UPLOAD_MB=49

# ---------- Postgres ----------
# You do not install Postgres on the host — the postgres:16-alpine
# container reads these vars. Password in DATABASE_URL must match
# POSTGRES_PASSWORD. First-time recipe: docs/20-deployment.md §5.1.1
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dwtgbot
POSTGRES_USER=dwtgbot
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://dwtgbot:replace-me@postgres:5432/dwtgbot
# S5: bot/api stay on the lean defaults; worker raises these in nl2/.env.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=1800

# ---------- Redis ----------
# Same idea: redis:7-alpine container, not apt install. If REDIS_PASSWORD
# is set, use redis://:PASSWORD@redis:6379/0 — see docs/20-deployment.md §5.1.1
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
# Hard memory cap for the Redis container (audit fix A4). volatile-lru
# policy evicts TTL'd keys first; arq queue keys have no TTL and stay.
# Tune down to e.g. 256mb if NL-1 is tight on RAM and workload is small.
REDIS_MAXMEMORY=1gb

# ---------- Public delivery (must match NL-2) ----------
PUBLIC_BASE_URL=https://media.example.com
TEMP_LINK_TTL_SECONDS=86400
TEMP_LINK_MAX_DOWNLOADS=5
TEMP_LINK_TOKEN_BYTES=32

# ---------- Internal API ----------
API_HOST=0.0.0.0
API_PORT=8080
API_INTERNAL_TOKEN=replace-me
# Dev/CI-only — leave EMPTY in production. Non-empty here enables
# POST /internal/test/enqueue and is rejected at startup when APP_ENV=production.
# See docs/37-load-and-capacity.md §6.
INTERNAL_TEST_TOKEN=
# NL-1 internal API: only /healthz — no media on disk. ``false`` matches
# ``main_bot`` (no storage gate). NL-2 **must** use ``true`` (default).
API_VALIDATE_STORAGE=false

# ---------- Worker / queue ----------
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_RETRIES=2
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_CONCURRENT_JOBS_PER_USER=2

# ---------- Cleanup / cache ----------
CLEANUP_INTERVAL_SECONDS=3600
MEDIA_CACHE_TTL_SECONDS=21600
# S1: leave ≥ JOB_TIMEOUT_SECONDS × 2.
ORPHAN_JOB_AGE_SECONDS=3900

# ---------- Backup ----------
BACKUP_DIR=/var/backups/dwtgbot
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# S2: off-site replication. Pick ONE backend and leave the other empty.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=dwtgbot
BACKUP_RCLONE_REMOTE=

# ---------- Tooling ----------
FFMPEG_BIN=ffmpeg
YTDLP_BIN=yt-dlp

# ---------- Sentry (L7) — optional error aggregation ----------
# The bot runs on NL-1 and benefits the most from Sentry (handler
# exceptions, analyze-link failures). Worker-side Sentry is set in
# deploy/nl2/.env.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# ---------- Rate limiting (docs/36-rate-limiting.md) ----------
# Audit fix A11: ships ENABLED by default. ``false`` is the insecure
# choice for a public bot (one viral link can DoS the service); if
# you truly need to disable rate limiting, document the reason in an
# ADR per docs/17-security.md and flip this knob to ``false``.
RL_ENABLED=true
RL_USER_BURST=5/60
RL_USER_HOURLY=20/3600
RL_CHAT_BURST=15/60
RL_GLOBAL_BURST=60/60
RL_DOMAIN_BURST=30/60
RL_NOTICE_TTL=30
RL_CHAT_NOTICE_TTL=30
# Fail-open is mandatory in production unless an ADR says otherwise (§3.4).
RL_FAIL_OPEN=true

# ---------- Metrics / observability (docs/35- §7, ADR-0006) ----------
# OFF by default. When you flip METRICS_ENABLED=true:
#   1. Keep METRICS_BIND_HOST=127.0.0.1 (Settings.validate_runtime
#      refuses 0.0.0.0 in production — see ADR-0006 §3.3).
#   2. Add a 'ports:' line to the bot service in docker-compose.yml that
#      exposes ${METRICS_PORT} *only* on the WireGuard subnet.
#   3. Configure your Prometheus scrape job for the same private IP.
# METRICS_USER_ID_LABEL=true is fine for hundreds-of-users-day scale.
# Flip to false before any public rollout — cardinality blow-up risk.
METRICS_ENABLED=false
METRICS_BIND_HOST=127.0.0.1
METRICS_PORT=9090
METRICS_USER_ID_LABEL=false

# ---------- Storage (unused on NL-1, present for shared image) ----------
STORAGE_PATH=/var/lib/dwtgbot/storage
STORAGE_TMP_PATH=/var/lib/dwtgbot/tmp
MAX_FILE_SIZE_MB=2048
# S10: no-op on NL-1 (the bot does not write to storage; LocalStorage
# .assert_free_space() is only called by ProcessDownloadUseCase on the
# worker). Kept here so ``Settings`` has a consistent value across nodes.
STORAGE_MIN_FREE_MB=0

# ---------- Internal API X-Accel (S6) ----------
# OFF on NL-1 — the api here is reached directly over WireGuard for
# /healthz and admin debug, not via the bundled nginx. Only NL-2 (the
# box that actually fronts nginx) flips this to true. Flipping it on
# without nginx in front of the api is a CVE.
XACCEL_ENABLED=false

# ---------- yt-dlp upstream (S9) ----------
# Outbound proxy used by yt-dlp. Empty = direct.
# Format: http://user:pass@host:port  or  socks5h://host:port
HTTPS_PROXY_URL=

# ---------- Circuit breaker for yt-dlp (L5) ----------
# The bot runs a metadata extraction (``extract_info``) during the
# analyze step, so it shares the breaker state with the NL-2 workers
# through Redis. Leaving CB_ENABLED=true is safe on single-bot deploys
# too — the breaker degrades to a no-op when the threshold is not met.
CB_ENABLED=true
CB_FAILURE_THRESHOLD=5
CB_WINDOW_SECONDS=60
CB_COOLDOWN_SECONDS=300
