# =====================================================================
# Media-plane vhost. ${SERVER_NAME} is replaced by the entrypoint.
# Strategy:
#   /.well-known/acme-challenge/  → webroot served from /var/www/certbot
#   :80                           → permanent redirect to HTTPS
#   :443                          → reverse-proxy to api:8080
#                                   GET /d/{token} validates the link;
#                                   the api responds with X-Accel-Redirect
#                                   pointing to the internal /_protected/
#                                   location, where nginx serves the file
#                                   via sendfile().
#
# Note on upstream resolution:
#   We deliberately do NOT use an ``upstream { server api:8080; }`` block
#   here. nginx resolves the hostname inside ``upstream`` exactly once,
#   at config-load time, and caches the IP forever. After
#   ``docker compose up -d api`` recreates the api container it gets a
#   new IP in the ``dwtgbot_media`` bridge network, but nginx (which
#   was not restarted) keeps proxying to the dead old IP and every
#   ``/d/<token>`` returns 502 ``Connection refused`` until somebody
#   notices and bounces nginx by hand. We hit this in production on
#   2026-04-26 immediately after auto-deploy rolled the api image.
#
# Fix: rely on Docker's embedded DNS at 127.0.0.11 plus a variable in
# ``proxy_pass``. Using a variable forces nginx to re-resolve the name
# per request (cached for ``valid=10s`` by the resolver), so a
# recreated api container is picked up within ~10 seconds without any
# nginx reload. Trade-off: we lose upstream-level keepalive. ``/d/`` is
# low-RPS and downloads are long-lived; an extra TCP handshake per
# request is invisible. If keepalive ever matters again, switch to a
# named upstream **and** wire ``deploy_update.sh`` to restart nginx
# whenever api is recreated — see ``deploy/scripts/deploy_update.sh``.

server {
    listen 80;
    listen [::]:80;
    server_name ${SERVER_NAME};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
        default_type "text/plain";
    }

    # Plain-HTTP health probe for container healthcheck and the deploy
    # script. Both probes run inside the container with busybox-wget, which
    # does NOT follow redirects and has no TLS trust store for our own
    # hostname on 127.0.0.1. Serving /healthz on :80 keeps the loopback
    # check simple while everything else still 301s to HTTPS.
    location = /healthz {
        access_log off;
        add_header Content-Type text/plain;
        return 200 "ok\n";
    }

    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name ${SERVER_NAME};

    ssl_certificate     /etc/letsencrypt/live/${SERVER_NAME}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/${SERVER_NAME}/privkey.pem;
    ssl_protocols       TLSv1.2 TLSv1.3;
    ssl_ciphers         HIGH:!aNULL:!MD5;
    ssl_prefer_server_ciphers on;
    ssl_session_cache   shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    include /etc/nginx/snippets/security.conf;

    # Health probe directly on nginx
    location /healthz {
        access_log off;
        return 200 "ok\n";
    }

    # Public temp-link endpoint. The api validates the token and replies
    # with X-Accel-Redirect → /_protected/<relative_path>, then nginx
    # serves the file from STORAGE_PATH efficiently.
    #
    # Rate limiting: the zones are declared in nginx.conf (see the
    # "temp_link_*" block there for sizing rationale). Burst=20 nodelay
    # absorbs legitimate retries without delaying them; over-budget
    # requests get an immediate 429 (limit_req_status). limit_conn caps
    # simultaneous downloads per IP so one client cannot starve the
    # worker pool. Rejections show up as ``limit_req_status="REJECTED"``
    # in the JSON access log — feed them into your dashboard from
    # docs/35-metrics-and-slo.md §6.
    #
    # Caching: ``Cache-Control: no-store`` prevents intermediate proxies
    # (corporate, ISP) and the user-agent from holding onto a file fetched
    # via a single-use, time-bounded token. ``always`` ensures the header
    # is set even on 4xx (e.g. 410 Gone after the link expired) so a
    # cached "the file is gone" page doesn't haunt a returning user.
    # ``Pragma`` + ``Expires`` cover ancient HTTP/1.0 intermediaries.
    # See docs/17-security.md §6 and docs/10-temp-links-and-delivery.md §9.
    location /d/ {
        limit_req  zone=temp_link_per_ip      burst=20 nodelay;
        limit_conn temp_link_conn_per_ip      8;

        # NS_ERROR_NET_CORRUPTED_CONTENT_ENCODING in Firefox (Russian:
        # «Ошибка искажения содержимого») was reported on 2026-04-26
        # while curl over the same URL succeeded. The diagnostic
        # signature: browser sends ``Accept-Encoding: gzip, deflate,
        # br, zstd``, curl by default doesn't. The corruption error
        # specifically means the response carried a ``Content-Encoding``
        # the body did not actually use. We don't want **any** content
        # negotiation on temp-link payloads — they are arbitrary
        # binaries (mp4, jpg, audio) coming through ``X-Accel-Redirect``
        # and re-encoding them is pure waste even when it works.
        # ``gzip off`` disables on-the-fly compression by nginx;
        # ``gunzip off`` makes sure we don't try to transparently
        # decompress an upstream that already advertised gzip; together
        # they guarantee a 1:1 byte stream from disk to socket.
        gzip   off;
        gunzip off;

        # Docker's embedded DNS (always at 127.0.0.11 inside any
        # user-defined bridge network). ``valid=10s`` bounds the staleness
        # window after a container recreation; ``ipv6=off`` keeps us off
        # AAAA lookups that the bridge network does not serve and which
        # add a 5s timeout to the first request after a restart.
        resolver        127.0.0.11 valid=10s ipv6=off;
        resolver_timeout 5s;
        # Variable in ``proxy_pass`` is what triggers per-request
        # re-resolution; without the variable nginx caches the IP
        # exactly like an ``upstream`` block does. See header comment.
        set $api_upstream http://api:${API_PORT};
        proxy_pass         $api_upstream;
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        # S6 (audit fix): X-Internal-XAccel is the trust gate that flips
        # ``api`` from streaming bytes itself to ``X-Accel-Redirect``.
        # If a client supplies it, nginx happily forwards the client
        # value unless we explicitly overwrite it. ``proxy_set_header``
        # in nginx replaces the header on the upstream request, so the
        # client-supplied value is effectively dropped here. The
        # comment exists because reordering or removing this line
        # silently re-introduces the spoofing path.
        proxy_set_header   X-Internal-XAccel "1";
        proxy_read_timeout 60s;
        proxy_buffering    off;

        add_header Cache-Control "no-store"      always;
        add_header Pragma        "no-cache"      always;
        add_header Expires       "0"             always;
    }

    # Internal location used by X-Accel-Redirect ONLY.
    # ``internal;`` makes nginx refuse direct external requests.
    # The Cache-Control headers are repeated here because ``add_header``
    # in nginx is *not* inherited from the parent location once the
    # child sets any add_header directive (and X-Accel hands off here).
    location /_protected/ {
        internal;
        alias /var/lib/dwtgbot/storage/;
        sendfile on;
        tcp_nopush on;
        # See the rationale block in /d/ above — same reasoning applies
        # to the static-serve side. ``X-Accel-Redirect`` lands here, so
        # this is the location that actually emits bytes; we want them
        # raw. Disabling at both layers is defence-in-depth: a future
        # global ``gzip on; gzip_types *;`` won't silently break
        # downloads.
        gzip   off;
        gunzip off;
        # Force download semantics for unknown types.
        types { }
        default_type application/octet-stream;
        # NB: we deliberately do NOT add ``Content-Disposition`` here.
        # The api already sets ``Content-Disposition: attachment;
        # filename="<original filename>"`` on the upstream response
        # before issuing X-Accel-Redirect; nginx forwards that header
        # to the client. If we ``add_header`` again here, the response
        # carries TWO ``Content-Disposition`` lines (the api's full
        # one with filename plus our bare ``attachment``). Most UAs
        # tolerate this, but some Firefox builds were observed to
        # abort the download with "Ошибка искажения содержимого" when
        # the headers were duplicated (2026-04-26 user report).
        # Trade-off accepted: if a future api code path forgets to
        # set Content-Disposition, the file will render inline
        # instead of downloading. That's a louder failure than a
        # silent dup, so we prefer it.
        add_header Cache-Control       "no-store"   always;
        add_header Pragma              "no-cache"   always;
        add_header Expires             "0"          always;
    }

    # Everything else: deny by default.
    location / {
        return 404;
    }
}
