# =====================================================================
# SINGLE (one host) environment — ADR-0011.
# Copy to deploy/single/.env on the server. NEVER commit the real .env.
#
# One file for every service on the host: no secret duplication, no
# WireGuard. Postgres/Redis are reached by docker service name.
# =====================================================================

# ---------- Image tags (REQUIRED; immutable; set per release) ----------
# Audit fix #4: docker-compose ``${VAR:?}``-checks each IMAGE_* var.
# Never use ``:latest`` — pin to ``sha-XXXXXXX`` (CI) or ``vX.Y.Z``.
# Forks: replace ``ariestop/dwtgbot`` with your fork path (lowercase).
IMAGE_BOT=ghcr.io/ariestop/dwtgbot-bot:sha-REPLACE_ME
IMAGE_API=ghcr.io/ariestop/dwtgbot-api:sha-REPLACE_ME
IMAGE_WORKER=ghcr.io/ariestop/dwtgbot-worker:sha-REPLACE_ME
IMAGE_BACKUP=ghcr.io/ariestop/dwtgbot-backup:sha-REPLACE_ME

# ---------- Container resource caps (defaults sized for 4 vCPU / 8 GB) ----------
# Sum of the default caps is ~6.7 GB. On a 2 vCPU / 4 GB box lower them,
# e.g. LIMIT_WORKER_MEM=1536m, LIMIT_WORKER_CPUS=1.5, LIMIT_DB_MEM=768m,
# LIMIT_REDIS_MEM=384m together with REDIS_MAXMEMORY=256mb.
# LIMIT_SMALL_MEM=512m
# LIMIT_SMALL_CPUS=1.0
# LIMIT_DB_MEM=1g
# LIMIT_DB_CPUS=1.0
# LIMIT_REDIS_MEM=1152m
# LIMIT_REDIS_CPUS=0.5
# LIMIT_WORKER_MEM=2g
# LIMIT_WORKER_CPUS=2.0
# Worker CPU weight vs. the default 1024 (deploy/single/single.override.yml).
# WORKER_CPU_SHARES=512

# ---------- App ----------
APP_ROLE=all
APP_ENV=production
LOG_LEVEL=INFO
LOG_JSON=true

# ---------- Telegram ----------
BOT_TOKEN=replace-me
BOT_ADMIN_IDS=
TELEGRAM_MAX_UPLOAD_MB=49

# ---------- Postgres (container on this host) ----------
# Password in DATABASE_URL must match POSTGRES_PASSWORD.
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dwtgbot
POSTGRES_USER=dwtgbot
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://dwtgbot:replace-me@postgres:5432/dwtgbot
# S5: pool for bot/api/cleanup. The worker gets its own, bigger pool via
# WORKER_DB_POOL_SIZE / WORKER_DB_MAX_OVERFLOW (keep the total under
# Postgres' max_connections=100).
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
# WORKER_DB_POOL_SIZE=10
# WORKER_DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=1800
DB_STATEMENT_TIMEOUT_S=30
DB_CONNECT_TIMEOUT_S=10
DB_IDLE_IN_TX_TIMEOUT_MS=60000

# ---------- Redis (container on this host) ----------
# If REDIS_PASSWORD is set, use redis://:PASSWORD@redis:6379/0
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0
REDIS_MAXMEMORY=1gb

# ---------- Public delivery ----------
SERVER_NAME=media.example.com
PUBLIC_BASE_URL=https://media.example.com
TEMP_LINK_TTL_SECONDS=86400
TEMP_LINK_MAX_DOWNLOADS=5
TEMP_LINK_TOKEN_BYTES=32

# ---------- Storage ----------
STORAGE_PATH=/var/lib/dwtgbot/storage
STORAGE_TMP_PATH=/var/lib/dwtgbot/tmp
MAX_FILE_SIZE_MB=2048
# S10: MANDATORY on a single host — storage shares the disk with
# Postgres and backups. Keep ~3 × MAX_FILE_SIZE_MB of headroom.
STORAGE_MIN_FREE_MB=6144

# ---------- API ----------
API_HOST=0.0.0.0
API_PORT=8080
API_INTERNAL_TOKEN=replace-me
# Dev/CI-only — leave EMPTY in production. See docs/37-load-and-capacity.md §6.
INTERNAL_TEST_TOKEN=
# The api streams files from local storage — keep validation on.
API_VALIDATE_STORAGE=true
# S6: the api sits behind the bundled nginx on this host.
XACCEL_ENABLED=true

# ---------- Worker / queue ----------
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_RETRIES=2
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_CONCURRENT_JOBS_PER_USER=2

# ---------- Cleanup / cache ----------
CLEANUP_INTERVAL_SECONDS=3600
MEDIA_CACHE_TTL_SECONDS=21600
# S1: leave ≥ JOB_TIMEOUT_SECONDS × 2.
ORPHAN_JOB_AGE_SECONDS=3900

# ---------- Backup ----------
BACKUP_DIR=/var/backups/dwtgbot
BACKUP_RETENTION_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
# S2: off-site replication is REQUIRED on a single host (dumps otherwise
# live on the same disk as the database). Pick ONE backend.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=dwtgbot
BACKUP_RCLONE_REMOTE=

# ---------- Tooling ----------
FFMPEG_BIN=ffmpeg
YTDLP_BIN=yt-dlp
FFPROBE_BIN=ffprobe
# S9: outbound proxy for yt-dlp upstream calls. Empty = direct.
HTTPS_PROXY_URL=
# Optional cookies files (Netscape format); deploy_update.sh keeps these
# pointed at /srv/dwtgbot/secrets/.
YOUTUBE_COOKIES_FILE=
INSTAGRAM_COOKIES_FILE=

# ---------- Instant download + live progress (ADR-0010) ----------
# Read by bot and worker; in split keep NL-1 and NL-2 identical.
# Commented values are the Settings defaults (docs/13-config-and-env.md).
INSTANT_DOWNLOAD_ENABLED=true
# BRAND_FOOTER=Спасибо за использование нашего бота @dwtgbot   # empty disables
# CANCEL_FLAG_TTL_SEC=1800
# POST_TEXT_TTL_SEC=86400
# POST_TEXT_MIN_CHARS=10
# POST_TEXT_MAX_CHARS=10000
# PROGRESS_TTL_SEC=600
# PROGRESS_META_TTL_SEC=1800
# PROGRESS_REDRAW_INTERVAL_SEC=2.0
# PROGRESS_DEBOUNCE_PERCENT=3
# PROGRESS_STALE_WARN_SEC=90
# PROGRESS_STALE_DROP_SEC=300

# ---------- Circuit breaker for yt-dlp (L5) ----------
CB_ENABLED=true
CB_FAILURE_THRESHOLD=5
CB_WINDOW_SECONDS=60
CB_COOLDOWN_SECONDS=300

# ---------- Sentry (L7) — optional error aggregation ----------
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# ---------- Rate limiting (docs/36-rate-limiting.md) ----------
RL_ENABLED=true
RL_USER_BURST=5/60
RL_USER_HOURLY=20/3600
RL_CHAT_BURST=15/60
RL_GLOBAL_BURST=60/60
RL_DOMAIN_BURST=30/60
RL_NOTICE_TTL=30
RL_CHAT_NOTICE_TTL=30
RL_FAIL_OPEN=true

# ---------- Metrics (docs/35- §7, ADR-0006) ----------
# Keep METRICS_BIND_HOST=127.0.0.1 (validate_runtime refuses 0.0.0.0).
METRICS_ENABLED=false
METRICS_BIND_HOST=127.0.0.1
METRICS_PORT=9090
METRICS_USER_ID_LABEL=false
METRICS_QUEUE_SAMPLE_INTERVAL_S=15.0
