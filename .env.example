# =====================================================================
# DWTGBot — example environment file
#
# Copy this file:
#   cp .env.example .env
#
# Real production values live on the servers in:
#   deploy/nl1/.env  (control plane)
#   deploy/nl2/.env  (media plane)
# =====================================================================

# ---------- App role ----------
# Used by entrypoints to pick the right startup path.
# One of: bot | api | worker | all (dev only)
APP_ROLE=all
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                # true in production

# ---------- Telegram ----------
BOT_TOKEN=replace-me
BOT_ADMIN_IDS=                # comma separated admin telegram user ids
TELEGRAM_MAX_UPLOAD_MB=49     # safe under Bot API 50MB limit

# ---------- Database (NL-1) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dwtgbot
POSTGRES_USER=dwtgbot
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://dwtgbot:replace-me@postgres:5432/dwtgbot

# ---------- Redis (NL-1) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ---------- Storage (NL-2) ----------
STORAGE_PATH=/var/lib/dwtgbot/storage
STORAGE_TMP_PATH=/var/lib/dwtgbot/tmp
MAX_FILE_SIZE_MB=2048

# ---------- Temp links / public delivery ----------
PUBLIC_BASE_URL=https://media.example.com
TEMP_LINK_TTL_SECONDS=86400        # 24h
TEMP_LINK_MAX_DOWNLOADS=5
TEMP_LINK_TOKEN_BYTES=32

# ---------- Internal API ----------
API_HOST=0.0.0.0
API_PORT=8080
API_INTERNAL_TOKEN=replace-me      # protects internal endpoints

# ---------- Worker / queue ----------
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_RETRIES=2
DOWNLOAD_TIMEOUT_SECONDS=900

# ---------- Cleanup / cache ----------
CLEANUP_INTERVAL_SECONDS=3600
MEDIA_CACHE_TTL_SECONDS=21600

# ---------- Backup ----------
BACKUP_DIR=/var/backups/dwtgbot
BACKUP_RETENTION_DAYS=14

# ---------- Tooling ----------
FFMPEG_BIN=ffmpeg
YTDLP_BIN=yt-dlp

# ---------- Metrics / observability (ADR-0006, ADR-0007) ----------
# Master switch — leave off in dev; enable per-process in prod.
METRICS_ENABLED=false
METRICS_BIND_HOST=127.0.0.1        # 0.0.0.0 is rejected in production
METRICS_PORT=9090                  # publish each process on a distinct host port
METRICS_USER_ID_LABEL=false        # cardinality risk; opt-in only
METRICS_QUEUE_SAMPLE_INTERVAL_S=15 # seconds; 1..300; ADR-0007 §2.6
