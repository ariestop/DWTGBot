# =====================================================================
# DWTGBot — example environment file
#
# Copy this file:
#   cp .env.example .env
#
# Real production values live on the servers in:
#   deploy/nl1/.env  (control plane)
#   deploy/nl2/.env  (media plane)
# =====================================================================

# ---------- App role ----------
# Used by entrypoints to pick the right startup path.
# One of: bot | api | worker | all (dev only)
APP_ROLE=all
APP_ENV=development           # development | production
LOG_LEVEL=INFO                # DEBUG | INFO | WARNING | ERROR
LOG_JSON=false                # true in production

# ---------- Telegram ----------
BOT_TOKEN=replace-me
BOT_ADMIN_IDS=                # comma separated admin telegram user ids
TELEGRAM_MAX_UPLOAD_MB=49     # safe under Bot API 50MB limit

# ---------- Database (NL-1) ----------
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_DB=dwtgbot
POSTGRES_USER=dwtgbot
POSTGRES_PASSWORD=replace-me
DATABASE_URL=postgresql+asyncpg://dwtgbot:replace-me@postgres:5432/dwtgbot
# S5: SQLAlchemy async pool sizing. Defaults are tuned for bot/api;
# raise DB_POOL_SIZE on the worker container when WORKER_CONCURRENCY > 5.
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT_S=30
DB_POOL_RECYCLE_S=1800
DB_STATEMENT_TIMEOUT_S=30
DB_CONNECT_TIMEOUT_S=10
DB_IDLE_IN_TX_TIMEOUT_MS=60000

# ---------- Redis (NL-1) ----------
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://redis:6379/0

# ---------- Storage (NL-2) ----------
STORAGE_PATH=/var/lib/dwtgbot/storage
STORAGE_TMP_PATH=/var/lib/dwtgbot/tmp
MAX_FILE_SIZE_MB=2048
# S10: refuse to start a download when STORAGE_PATH has less than this
# many MB free. 0 disables the guard. Set to ~3 × MAX_FILE_SIZE_MB in
# production so a single failed cleanup doesn't push the FS to 100 %.
STORAGE_MIN_FREE_MB=0

# ---------- Temp links / public delivery ----------
PUBLIC_BASE_URL=https://media.example.com
TEMP_LINK_TTL_SECONDS=3600         # 1h
TEMP_LINK_MAX_DOWNLOADS=5
TEMP_LINK_TOKEN_BYTES=32

# ---------- Internal API ----------
API_HOST=0.0.0.0
API_PORT=8080
API_INTERNAL_TOKEN=replace-me      # protects internal endpoints
# S6: trust gate for nginx X-Accel-Redirect mode on /d/{token}.
# Set to true ONLY when deploy/nginx/conf.d/media.conf is in front of
# the api (the bundled config sets the X-Internal-XAccel header
# unconditionally, which the api requires). Leaving this false makes
# the api stream the file itself — slower but safer.
XACCEL_ENABLED=false
API_VALIDATE_STORAGE=true
# Dev/capacity tests only; MUST stay empty in production.
INTERNAL_TEST_TOKEN=

# ---------- Worker / queue ----------
WORKER_CONCURRENCY=2
JOB_TIMEOUT_SECONDS=1800
JOB_MAX_RETRIES=2
DOWNLOAD_TIMEOUT_SECONDS=900
MAX_CONCURRENT_JOBS_PER_USER=2

# ---------- Cleanup / cache ----------
CLEANUP_INTERVAL_SECONDS=3600
MEDIA_CACHE_TTL_SECONDS=21600
# S1: cleanup_worker reaps PROCESSING jobs whose updated_at is older
# than this. MUST be ≥ JOB_TIMEOUT_SECONDS by a comfortable margin.
ORPHAN_JOB_AGE_SECONDS=3900

# ---------- Backup ----------
BACKUP_DIR=/var/backups/dwtgbot
BACKUP_RETENTION_DAYS=14
# S2: off-site replication. Pick ONE backend; leave both empty to skip.
# AWS:    requires aws-cli and ambient credentials (instance profile or env).
# rclone: any backend (B2, GCS, SFTP, etc.) — `rclone config` first.
BACKUP_S3_BUCKET=
BACKUP_S3_PREFIX=dwtgbot
BACKUP_RCLONE_REMOTE=

# ---------- Tooling ----------
FFMPEG_BIN=ffmpeg
YTDLP_BIN=yt-dlp
FFPROBE_BIN=ffprobe
# S9: optional outbound proxy used by yt-dlp. Empty = direct.
# Format: http://user:pass@host:port  or  socks5h://host:port
HTTPS_PROXY_URL=
# Optional YouTube cookies file (Netscape format) for age/auth-gated videos.
# Path must be readable by the bot and worker containers.
YOUTUBE_COOKIES_FILE=
# Optional Instagram cookies file (Netscape format) for auth-required posts.
# Path must be readable by the bot and worker containers.
INSTAGRAM_COOKIES_FILE=

# ---------- Instant download + live progress (ADR-0010) ----------
# Read by bot and worker; in split keep NL-1 and NL-2 identical.
# Commented values are the Settings defaults (docs/13-config-and-env.md).
INSTANT_DOWNLOAD_ENABLED=true
# BRAND_FOOTER=Спасибо за использование нашего бота @dwtgbot   # empty disables
# CANCEL_FLAG_TTL_SEC=1800
# POST_TEXT_TTL_SEC=86400
# POST_TEXT_MIN_CHARS=10
# POST_TEXT_MAX_CHARS=10000
# PROGRESS_TTL_SEC=600
# PROGRESS_META_TTL_SEC=1800
# PROGRESS_REDRAW_INTERVAL_SEC=2.0
# PROGRESS_DEBOUNCE_PERCENT=3
# PROGRESS_STALE_WARN_SEC=90
# PROGRESS_STALE_DROP_SEC=300

# ---------- Circuit breaker — yt-dlp upstream (L5) ----------
# Per-host, shared via Redis across the worker fleet. Opens when
# CB_FAILURE_THRESHOLD consecutive throttle-shaped errors land
# within CB_WINDOW_SECONDS; stays open for CB_COOLDOWN_SECONDS.
# Flip CB_ENABLED=false on single-process dev boxes without Redis.
CB_ENABLED=true
CB_FAILURE_THRESHOLD=5
CB_WINDOW_SECONDS=60
CB_COOLDOWN_SECONDS=300

# ---------- Sentry / GlitchTip (L7) ----------
# Error aggregation. Blank DSN disables the integration entirely;
# the code is still included in the image, so turning it on is a
# one-env-var redeploy. SENTRY_ENVIRONMENT falls back to APP_ENV.
SENTRY_DSN=
SENTRY_ENVIRONMENT=
SENTRY_TRACES_SAMPLE_RATE=0.0
SENTRY_RELEASE=

# ---------- Rate limiting (docs/36-rate-limiting.md) ----------
RL_ENABLED=true
RL_USER_BURST=5/60
RL_USER_HOURLY=20/3600
RL_CHAT_BURST=15/60
RL_GLOBAL_BURST=60/60
RL_DOMAIN_BURST=30/60
RL_NOTICE_TTL=30
RL_CHAT_NOTICE_TTL=30
RL_FAIL_OPEN=true

# ---------- Metrics / observability (ADR-0006, ADR-0007) ----------
# Master switch — leave off in dev; enable per-process in prod.
METRICS_ENABLED=false
METRICS_BIND_HOST=127.0.0.1        # 0.0.0.0 is rejected in production
METRICS_PORT=9090                  # publish each process on a distinct host port
METRICS_USER_ID_LABEL=false        # cardinality risk; opt-in only
METRICS_QUEUE_SAMPLE_INTERVAL_S=15 # seconds; 1..300; ADR-0007 §2.6
